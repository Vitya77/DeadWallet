@model List<IEnumerable<DeadWallet.DAL.Models.Budget>>
@inject DeadWallet.BLL.Interfaces.ITransactionService _transactionService
@inject DeadWallet.BLL.Interfaces.ITagService _tagService
@using DeadWallet.DAL.Models

@{
    ViewData["Title"] = "Dashboard";
    var tags = await _tagService.GetAllTagsAsync();
    var budgets = Model[0].Concat(Model[1]);
    var ownedBudgets = Model[0].Count();
}

<div class="container mt-5 budgets-container">
    <div class="row h-100">
        <div class="col-md-3 d-flex flex-column justify-content-between align-items-center h-100">
            <div class="list-group w-100" id="v-tabs-list" role="tablist">
                <h5 class="my-4">Owned budgets</h5>
                @for (int i = 0; i < ownedBudgets; i++)
                {
                    <a class="list-group-item list-group-item-action @(i == 0 ? "active" : "")"
                       id="@($"v-tab{i}")"
                       data-bs-toggle="list"
                       href="@($"#v-tab{i}-content")"
                       role="tab">
                        @budgets.ToList()[i].Title
                    </a>
                }
                <h5 class="my-4">Shared budgets</h5>
                @for (int i = ownedBudgets; i < budgets.Count(); i++)
                {
                    <a class="list-group-item list-group-item-action @(i == 0 ? "active" : "")"
                       id="@($"v-tab{i}")"
                       data-bs-toggle="list"
                       href="@($"#v-tab{i}-content")"
                       role="tab">
                        @budgets.ToList()[i].Title
                    </a>
                }
            </div>
            <a asp-action="CreateBudget" class="btn btn-primary mt-3">Create budget</a>
        </div>

        <div class="col-md-9">
            <div class="tab-content" id="v-tabs-content">
                @for (int i = 0; i < budgets.Count(); i++)
                {
                    var budget = budgets.ToList()[i];
                    <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="@($"v-tab{i}-content")" role="tabpanel">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h4>@budget.Title</h4>
                                <p>Current balance: <strong>@budget.Balance.ToString("C")</strong></p>
                            </div>
                            <a asp-controller="Transaction" asp-action="BudgetTransactions" asp-route-budgetId="@budget.Id" class="btn btn-outline-primary">Transaction History</a>
                        </div>

                        <form asp-action="AddTransaction" asp-controller="Transaction" method="post" class="mt-4">
                            <input type="hidden" name="BudgetId" value="@budget.Id" />

                            <div class="form-group mb-3">
                                <label>Amount</label>
                                <input type="text"
                                       inputmode="decimal"
                                       pattern="[0-9]+([\.,][0-9]+)?"
                                       class="form-control"
                                       name="Amount"
                                       required
                                       placeholder="0.00" />
                            </div>

                            <div class="form-group mb-3">
                                <label>Description</label>
                                <input type="text" class="form-control" name="Description" />
                            </div>

                            <div class="form-group mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <label>Tag</label>
                                    <a asp-controller="Tag" asp-action="Index" class="btn btn-sm btn-outline-secondary">Manage Tags</a>
                                </div>
                                <select class="form-control" name="TagId" id="tagSelect-@budget.Id">
                                    <option value="">No Tag</option>
                                    @foreach (var tag in tags)
                                    {
                                        <option value="@tag.Id" data-color="@tag.Color" style="background-color:@tag.Color; color: white;">
                                            @tag.Name
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" name="IsExpense" id="isExpense" value="true" />
                                <input type="hidden" name="IsExpense" value="false" />
                                <label class="form-check-label" for="isExpense">Is Expense</label>
                            </div>

                            <button type="submit" class="btn btn-primary">Add Transaction</button>
                        </form>

                        <!-- Success Message -->
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success mt-3">
                                @TempData["SuccessMessage"]
                            </div>
                        }

                        <!-- Error Message -->
                        @if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger mt-3">
                                @TempData["ErrorMessage"]
                            </div>
                        }

                        <!-- Transactions List -->
                        <div class="mt-4">
                            <h5>Recent Transactions</h5>
                            <ul class="list-group">
                                @{
                                    var transactionResult = await _transactionService.GetTransactionsForBudgetAsync(budget.Id);

                                    if (transactionResult.Success)
                                    {
                                        var transactions = transactionResult.Res
                                        .OrderByDescending(t => t.Id)
                                        .Take(5)
                                        .Select(t => new
                                        {
                                            Transaction = t,
                                            Tag = tags.FirstOrDefault(tag => tag.Id == t.TagId)
                                        });

                                        foreach (var item in transactions)
                                        {
                                            var transaction = item.Transaction;
                                            var tag = item.Tag;

                                            <li class="list-group-item @(transaction.IsExpense ? "list-group-item-danger" : "list-group-item-success")">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                                        <div>
                                                            @(string.IsNullOrEmpty(transaction.Description) ? "No description" : transaction.Description) -
                                                            <strong>@transaction.Amount.ToString("C")</strong>
                                                        </div>
                                                        @if (tag != null)
                                                        {
                                                            <span class="badge rounded-pill d-inline-flex align-items-center"
                                                                  style="background-color:@tag.Color; color:white; padding: 0.25em 0.6em; font-size:0.8em;">
                                                                <i class="bi bi-tag-fill me-1" style="font-size:0.7em;"></i>
                                                                @tag.Name
                                                            </span>
                                                        }
                                                    </div>
                                                    <div>
                                                        <span class="badge @(transaction.IsExpense ? "bg-danger" : "bg-success")">
                                                            @(transaction.IsExpense ? "Expense" : "Income")
                                                        </span>
                                                    </div>
                                                </div>
                                            </li>
                                        }
                                    }
                                    else
                                    {
                                        <li class="list-group-item list-group-item-warning">
                                            <i class="bi bi-exclamation-triangle me-2"></i>
                                            Unable to load transactions: @transactionResult.Message
                                        </li>
                                    }
                                }
                            </ul>
                        </div>

                        <script>
                            document.getElementById('tagSelect-@budget.Id').addEventListener('change', function() {
                                let selectedOption = this.options[this.selectedIndex];
                                this.style.backgroundColor = selectedOption.getAttribute('data-color');
                                this.style.color = 'white';
                            });
                        </script>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .budgets-container {
        height: 75vh;
    }

    select.form-control option {
        padding: 8px;
        margin: 4px 0;
    }

    .list-group-item .badge {
        font-size: 0.8em;
    }

    .gap-2 {
        gap: 0.5rem;
    }

    .list-group-item {
        padding: 1rem;
    }

    .form-control-color {
        height: 38px;
        width: 50px;
        cursor: pointer;
    }
</style>