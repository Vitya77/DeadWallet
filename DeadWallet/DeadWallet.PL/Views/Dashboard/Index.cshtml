@model IEnumerable<DeadWallet.DAL.Models.Budget>

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-5 budgets-container">
    <div class="row h-100">
        <!-- Vertical Tabs -->
        <div class="col-md-3 d-flex flex-column justify-content-between align-items-center h-100">
            <div class="list-group w-100" id="v-tabs-list" role="tablist">
                @for (int i = 0; i < Model.Count(); i++)
                {
                    <a class=@(i == 0 ? "list-group-item list-group-item-action active" : "list-group-item list-group-item-action")) id="@($"v-tab{i}")" data-bs-toggle="list" href="@($"#v-tab{i}-content")" role="tab">@Model.ToList()[i].Title</a>
                }
            </div>

            <a asp-action="CreateBudget" class="btn btn-primary">Create budget</a>
        </div>
        <!-- Tab Content -->
        <div class="col-md-9">
            <div class="tab-content" id="v-tabs-content">
                @for (int i = 0; i < Model.Count(); i++)
                {
                    <div class=@(i == 0 ? "tab-pane fade show active" : "tab-pane fade") id=@($"v-tab{i}-content") role="tabpanel" aria-labelledby=@($"v-tab{i}")>
                        <h4>@Model.ToList()[i].Title</h4>
                        <p>@Model.ToList()[i].Balance</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .budgets-container {
        height: 75vh;
    }
</style>