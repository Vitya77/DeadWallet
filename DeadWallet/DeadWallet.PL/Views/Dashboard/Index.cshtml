@model IEnumerable<DeadWallet.DAL.Models.Budget>
@inject DeadWallet.BLL.Interfaces.ITransactionService _transactionService

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-5 budgets-container">
    <div class="row h-100">
        <!-- Vertical Tabs -->
        <div class="col-md-3 d-flex flex-column justify-content-between align-items-center h-100">
            <div class="list-group w-100" id="v-tabs-list" role="tablist">
                @for (int i = 0; i < Model.Count(); i++)
                {
                    <a class=@(i == 0 ? "list-group-item list-group-item-action active" : "list-group-item list-group-item-action")
                       id="@($"v-tab{i}")"
                       data-bs-toggle="list"
                       href="@($"#v-tab{i}-content")"
                       role="tab">
                        @Model.ToList()[i].Title
                    </a>
                }
            </div>
            <a asp-action="CreateBudget" class="btn btn-primary">Create budget</a>
        </div>

        <!-- Tab Content -->
        <div class="col-md-9">
            <div class="tab-content" id="v-tabs-content">
                @for (int i = 0; i < Model.Count(); i++)
                {
                    var budget = Model.ToList()[i];
                    <div class=@(i == 0 ? "tab-pane fade show active" : "tab-pane fade")
                         id=@($"v-tab{i}-content")
                         role="tabpanel"
                         aria-labelledby=@($"v-tab{i}")>

                        <h4>@budget.Title</h4>
                        <p>Current balance: <strong>@budget.Balance.ToString("C")</strong></p>

                        <!-- Transaction Form -->
                        <form asp-action="AddTransaction" asp-controller="Transaction" method="post" class="mt-4">
                            <input type="hidden" name="BudgetId" value="@budget.Id" />

                            <div class="form-group mb-3">
                                <label>Amount</label>
                                <input type="text"
                                       inputmode="decimal"
                                       pattern="[0-9]+([\.,][0-9]+)?"
                                       class="form-control"
                                       name="Amount"
                                       required
                                       placeholder="0.00" />
                            </div>

                            <div class="form-group mb-3">
                                <label>Description</label>
                                <input type="text" class="form-control" name="Description" />
                            </div>

                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" name="IsExpense" id="isExpense" value="true" />
                                <input type="hidden" name="IsExpense" value="false" />
                                <label class="form-check-label" for="isExpense">Is Expense</label>
                            </div>

                            <button type="submit" class="btn btn-primary">Add Transaction</button>
                        </form>

                        <!-- Success Message -->
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success mt-3">
                                @TempData["SuccessMessage"]
                            </div>
                        }

                        <!-- Error Message -->
                        @if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger mt-3">
                                @TempData["ErrorMessage"]
                            </div>
                        }

                        <!-- Transactions List -->
                        <div class="mt-4">
                            <h5>Recent Transactions</h5>
                            <ul class="list-group">
                                @{
                                    var transactionResult = await _transactionService.GetTransactionsForBudgetAsync(budget.Id);

                                    if (transactionResult.Success)
                                    {
                                        var transactions = transactionResult.Res.OrderByDescending(t => t.Id).Take(5);
                                        foreach (var transaction in transactions)
                                        {
                                            <li class="list-group-item @(transaction.IsExpense ? "list-group-item-danger" : "list-group-item-success")">
                                                @(string.IsNullOrEmpty(transaction.Description) ? "No description" : transaction.Description) - @transaction.Amount.ToString("C")
                                                <span class="badge bg-secondary float-end">
                                                    @(transaction.IsExpense ? "Expense" : "Income")
                                                </span>
                                            </li>
                                        }
                                    }
                                    else
                                    {
                                        <li class="list-group-item list-group-item-warning">
                                            Unable to load transactions: @transactionResult.Message
                                        </li>
                                    }
                                }
                            </ul>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .budgets-container {
        height: 75vh;
    }
</style>
