@model List<IEnumerable<DeadWallet.DAL.Models.Budget>>
@inject DeadWallet.BLL.Interfaces.ITransactionService _transactionService
@inject DeadWallet.BLL.Interfaces.ITagService _tagService
@using DeadWallet.DAL.Models
@using System.Text.Json

@{
    ViewData["Title"] = "Dashboard";
    var tags = await _tagService.GetAllTagsAsync();
    var budgets = Model[0].Concat(Model[1]).ToList();
    var ownedBudgets = Model[0].Count();
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container-fluid my-5">
    <div class="row">
        <div class="col-md-3">
            <div class="bg-light border rounded p-3 h-100 d-flex flex-column">
                <div class="mb-4">
                    <h5>Owned Budgets</h5>
                    <div class="list-group" id="v-tabs-list">
                        @for (int i = 0; i < ownedBudgets; i++)
                        {
                            <a class="list-group-item list-group-item-action @(i == 0 ? "active" : "")"
                               id="@($"v-tab{i}")"
                               data-bs-toggle="list"
                               href="@($"#v-tab{i}-content")"
                               role="tab">
                                @budgets[i].Title
                            </a>
                        }
                    </div>
                </div>

                <div class="mb-4">
                    <h5>Shared Budgets</h5>
                    <div class="list-group">
                        @for (int i = ownedBudgets; i < budgets.Count; i++)
                        {
                            <a class="list-group-item list-group-item-action"
                               id="@($"v-tab{i}")"
                               data-bs-toggle="list"
                               href="@($"#v-tab{i}-content")"
                               role="tab">
                                @budgets[i].Title
                            </a>
                        }
                    </div>
                </div>

                <a asp-action="CreateBudget" class="btn btn-primary mt-auto">Create Budget</a>
            </div>
        </div>

        <div class="col-md-9">
            <div class="tab-content" id="v-tabs-content">
                @for (int i = 0; i < budgets.Count; i++)
                {
                    var budget = budgets[i];
                    <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="@($"v-tab{i}-content")" role="tabpanel">
                        <div class="card mb-4">
                            <div class="card-body d-flex justify-content-between align-items-center">
                                <div>
                                    <h4 class="card-title mb-1">@budget.Title</h4>
                                    <p class="card-text">Current Balance: <strong>@budget.Balance.ToString("C")</strong></p>
                                </div>
                                <a asp-controller="Transaction" asp-action="BudgetTransactions" asp-route-budgetId="@budget.Id" class="btn btn-outline-primary">Transaction History</a>
                            </div>
                        </div>

                        <div class="card mb-4">
                            <div class="card-body">
                                <h5>Income vs Expenses</h5>
                                <div class="chart-container" style="height:300px;">
                                    <canvas id="chart-@budget.Id"></canvas>
                                </div>
                            </div>
                        </div>

                        <div class="card mb-4">
                            <div class="card-body">
                                <h5 class="mb-3">Add Transaction</h5>
                                <form asp-action="AddTransaction" asp-controller="Transaction" method="post">
                                    <input type="hidden" name="BudgetId" value="@budget.Id" />

                                    <div class="mb-3">
                                        <label class="form-label">Amount</label>
                                        <input type="text" inputmode="decimal" pattern="[0-9]+([\.,][0-9]+)?" class="form-control" name="Amount" required placeholder="0.00" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Description</label>
                                        <input type="text" class="form-control" name="Description" />
                                    </div>

                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <label class="form-label">Tag</label>
                                            <a asp-controller="Tag" asp-action="Index" class="btn btn-sm btn-outline-secondary">Manage Tags</a>
                                        </div>
                                        <select class="form-select" name="TagId" id="tagSelect-@budget.Id">
                                            <option value="">No Tag</option>
                                            @foreach (var tag in tags)
                                            {
                                                <option value="@tag.Id" data-color="@tag.Color" style="background-color:@tag.Color; color:white;">
                                                    @tag.Name
                                                </option>
                                            }
                                        </select>
                                    </div>

                                    <div class="form-check mb-3">
                                        <input class="form-check-input" type="checkbox" name="IsExpense" id="isExpense-@budget.Id" value="true" />
                                        <input type="hidden" name="IsExpense" value="false" />
                                        <label class="form-check-label" for="isExpense-@budget.Id">Is Expense</label>
                                    </div>

                                    <button type="submit" class="btn btn-primary">Add Transaction</button>
                                </form>

                                @if (TempData["SuccessMessage"] != null)
                                {
                                    <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
                                }

                                @if (TempData["ErrorMessage"] != null)
                                {
                                    <div class="alert alert-danger mt-3">@TempData["ErrorMessage"]</div>
                                }
                            </div>
                        </div>

                        <div class="card mb-4">
                            <div class="card-body">
                                <h5>Recent Transactions</h5>
                                <ul class="list-group">
                                    @{
                                        var result = await _transactionService.GetTransactionsForBudgetAsync(budget.Id);
                                        if (result.Success)
                                        {
                                            var recent = result.Res.OrderByDescending(x => x.Id).Take(5).ToList();
                                            foreach (var t in recent)
                                            {
                                                var tag = tags.FirstOrDefault(x => x.Id == t.TagId);
                                                <li class="list-group-item @(t.IsExpense ? "list-group-item-danger" : "list-group-item-success")">
                                                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                                                        <div>
                                                            @(string.IsNullOrEmpty(t.Description) ? "No description" : t.Description) -
                                                            <strong>@t.Amount.ToString("C")</strong>
                                                            @if (tag != null)
                                                            {
                                                                <span class="badge rounded-pill ms-2" style="background-color:@tag.Color; color:white;">
                                                                    @tag.Name
                                                                </span>
                                                            }
                                                        </div>
                                                        <span class="badge @(t.IsExpense ? "bg-danger" : "bg-success")">
                                                            @(t.IsExpense ? "Expense" : "Income")
                                                        </span>
                                                    </div>
                                                </li>
                                            }
                                        }
                                        else
                                        {
                                            <li class="list-group-item list-group-item-warning">Error: @result.Message</li>
                                        }
                                    }
                                </ul>
                            </div>
                        </div>

                        <script>
                            document.getElementById('tagSelect-@budget.Id').addEventListener('change', function () {
                                let opt = this.options[this.selectedIndex];
                                this.style.backgroundColor = opt.getAttribute('data-color');
                                this.style.color = 'white';
                            });
                        </script>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const budgetIds = @Html.Raw(JsonSerializer.Serialize(budgets.Select(b => b.Id)));
        budgetIds.forEach(budgetId => {
            const ctx = document.getElementById(`chart-${budgetId}`);
            if (ctx) {
                fetch(`/Transaction/GetBudgetTotals?budgetId=${budgetId}`)
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            new Chart(ctx, {
                                type: 'doughnut',
                                data: {
                                    labels: ['Income', 'Expenses'],
                                    datasets: [{
                                        data: [data.income, data.expenses],
                                        backgroundColor: ['rgba(40,167,69,0.8)', 'rgba(220,53,69,0.8)'],
                                        borderColor: ['rgba(40,167,69,1)', 'rgba(220,53,69,1)'],
                                        borderWidth: 1
                                    }]
                                },
                                options: {
                                    responsive: true,
                                    plugins: {
                                        legend: { position: 'bottom' },
                                        tooltip: {
                                            callbacks: {
                                                label: function (ctx) {
                                                    return `${ctx.label}: ${ctx.raw.toFixed(2)}`;
                                                }
                                            }
                                        }
                                    }
                                }
                            });
                        }
                    })
                    .catch(err => console.error(err));
            }
        });
    });
</script>
