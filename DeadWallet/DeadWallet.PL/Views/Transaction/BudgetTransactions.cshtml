<div class="container" >
    <h4>Transaction History</h4>
    <div class="mb-3">
        <input type="text" id="searchTransactions" class="form-control" placeholder="Search by description...">
    </div>
    <table class="table table-striped">
        <thead>
        <tr>
            <th>Description</th>
            <th>Amount</th>
            <th>
                Date
                <button id="sortDateBtn" class="btn btn-sm btn-outline-secondary">Sort</button>
            </th>
            <th>Type</th>
        </tr>
        </thead>
        <tbody id="transactionTableBody">
        @{ var allTransactions = (await _transactionService.GetAllTransactionsAsync()).Res.OrderBy(t => t.CreatedAt); }
        @foreach (var transaction in allTransactions.OrderBy(t => t.CreatedAt))
        {
            <tr>
                <td>@(string.IsNullOrEmpty(transaction.Description) ? "No description" : transaction.Description)</td>
                <td>@transaction.Amount.ToString("C")</td>
                <td class="transaction-date">@transaction.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    <span class="badge @(transaction.IsExpense ? "bg-danger" : "bg-success")">
                        @(transaction.IsExpense ? "Expense" : "Income")
                    </span>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<script>
    document.getElementById("searchTransactions").addEventListener("input", function () {
        let filter = this.value.toLowerCase();
        let rows = document.querySelectorAll("#transactionTableBody tr");

        rows.forEach(row => {
            let description = row.cells[0].innerText.toLowerCase();
            row.style.display = description.includes(filter) ? "" : "none";
        });
    });

    document.getElementById("sortDateBtn").addEventListener("click", function () {
        let tableBody = document.getElementById("transactionTableBody");
        let rows = Array.from(tableBody.querySelectorAll("tr"));

        let sortedRows = rows.sort((a, b) => {
            let dateA = new Date(a.querySelector(".transaction-date").innerText);
            let dateB = new Date(b.querySelector(".transaction-date").innerText);
            return dateB - dateA;
        });

        tableBody.innerHTML = "";
        sortedRows.forEach(row => tableBody.appendChild(row));
    });
</script>         