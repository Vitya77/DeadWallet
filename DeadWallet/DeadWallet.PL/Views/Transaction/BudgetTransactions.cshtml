@model List<DeadWallet.DAL.Models.Transaction>
@{
    ViewData["Title"] = "Історія транзакцій";
    var tagsDict = ViewBag.Tags as Dictionary<int, DeadWallet.DAL.Models.Tag>;
}

<h2>Історія транзакцій</h2>

<table class="table table-hover mt-4">
    <thead class="table-dark">
        <tr>
            <th>Опис</th>
            <th>Тег</th>
            <th>Сума</th>
            <th>Дата</th>
            <th>Тип</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var transaction in Model)
        {
            <tr>
                <td>
                    @(string.IsNullOrEmpty(transaction.Description) ? "Без опису" : transaction.Description)
                </td>
                <td>
                    @if (transaction.TagId.HasValue && tagsDict != null && tagsDict.ContainsKey(transaction.TagId.Value))
                    {
                        var tag = tagsDict[transaction.TagId.Value];
                        <span class="badge rounded-pill d-inline-flex align-items-center"
                              style="background-color:@tag.Color; color:white; padding: 0.25em 0.6em; font-size:0.8em;">
                            <i class="bi bi-tag-fill me-1" style="font-size:0.7em;"></i>
                            @tag.Name
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
                <td>@transaction.Amount.ToString("C")</td>
                <td class="transaction-date">@transaction.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    <span class="badge @(transaction.IsExpense ? "bg-danger" : "bg-success")">
                        @(transaction.IsExpense ? "Витрата" : "Дохід")
                    </span>
                </td>
            </tr>
        }
    </tbody>
</table>

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
