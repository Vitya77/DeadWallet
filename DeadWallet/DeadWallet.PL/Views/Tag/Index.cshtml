@model List<DeadWallet.DAL.Models.Tag>

@{
    ViewData["Title"] = "Manage Tags";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="bi bi-tags"></i> Manage Tags
                    </h3>
                </div>
                <div class="card-body">
                    <!-- Форма для додавання нового тегу -->
                    <div class="mb-4 p-3 border rounded bg-light">
                        <h5><i class="bi bi-plus-square"></i> Add New Tag</h5>
                        <form action="@Url.Action("AddTag", "Tag")" method="post" class="mt-3">
                            <div class="row g-3 align-items-center">
                                <div class="col-md-5">
                                    <label for="tagName" class="form-label">Tag Name</label>
                                    <input type="text" id="tagName" name="name" class="form-control"
                                           placeholder="Enter tag name" required>
                                </div>
                                <div class="col-md-3">
                                    <label for="tagColor" class="form-label">Tag Color</label>
                                    <div class="input-group">
                                        <input type="color" id="tagColor" name="color"
                                               class="form-control form-control-color" value="#563d7c" title="Choose color">
                                        <span class="input-group-text" id="colorHex">#563d7c</span>
                                    </div>
                                </div>
                                <div class="col-md-4 d-flex align-items-end">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="bi bi-plus-circle"></i> Add Tag
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Список існуючих тегів -->
                    <div class="mt-4">
                        <h5><i class="bi bi-list-ul"></i> Existing Tags</h5>
                        @if (Model.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Tag Name</th>
                                            <th>Color Preview</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var tag in Model.OrderBy(t => t.Name))
                                        {
                                            <tr>
                                                <td>
                                                    <span class="badge rounded-pill d-inline-flex align-items-center"
                                                          style="background-color:@tag.Color; color:white; padding: 0.35em 0.65em;">
                                                        <i class="bi bi-tag-fill me-1"></i> @tag.Name
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="color-preview" style="background-color: @tag.Color;"
                                                         data-bs-toggle="tooltip" title="@tag.Color"></div>
                                                </td>
                                                <td>
                                                    <div class="d-flex gap-2">
                                                        <a href="@Url.Action("Edit", "Tag", new { id = tag.Id })"
                                                           class="btn btn-sm btn-outline-primary">
                                                            <i class="bi bi-pencil"></i> Edit
                                                        </a>
                                                        <form action="@Url.Action("DeleteTag", "Tag")" method="post"
                                                              onsubmit="return confirm('Are you sure you want to delete this tag?')">
                                                            <input type="hidden" name="id" value="@tag.Id">
                                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                                <i class="bi bi-trash"></i> Delete
                                                            </button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i> No tags found. Start by adding your first tag above.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Оновлення HEX значення кольору при зміні
        document.getElementById('tagColor').addEventListener('input', function() {
            document.getElementById('colorHex').textContent = this.value;
        });

        // Ініціалізація підказок
        document.addEventListener('DOMContentLoaded', function() {
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (element) {
                return new bootstrap.Tooltip(element);
            });
        });
    </script>
}

<style>
    .form-control-color {
        width: 3rem;
        height: calc(1.5em + 1rem + 2px);
        padding: 0.25rem;
        cursor: pointer;
    }

    .badge {
        font-size: 0.9em;
        min-width: 80px;
        justify-content: center;
    }

    .color-preview {
        width: 30px;
        height: 30px;
        border-radius: 4px;
        border: 1px solid #dee2e6;
        cursor: help;
    }

    .input-group-text {
        min-width: 80px;
        font-family: monospace;
    }
</style>