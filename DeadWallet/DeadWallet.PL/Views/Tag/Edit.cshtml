@model DeadWallet.DAL.Models.Tag

@{
    ViewData["Title"] = "Edit Tag";
}

<div class="container mt-4">
    <h2>Edit Tag</h2>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Tag Name</label>
            <input asp-for="Name" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Color" class="form-label">Color</label>
            <input asp-for="Color" type="color" class="form-control form-control-color" required />
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="ManageTags" class="btn btn-secondary">Cancel</a>
    </form>
</div>
