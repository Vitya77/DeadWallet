@model RecoverPasswordViewModel
@{
    ViewData["Title"] = "Recover password";
}

<section class="w-100 h-100 d-flex justify-content-center align-items-center">
    <form style="width: 400px;" class="d-flex flex-column gap-3 border-1 border-black" asp-action="RecoverPassword" method="post">
        <div class="form-group">
            <label for="OtpCode">Otp code</label>
            <input type="text" class="form-control" id="OtpCode" name="OtpCode" value="@Model.OtpCode" />
            <span asp-validation-for="OtpCode" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label for="Password">New password</label>
            <input type="text" class="form-control" id="Password" name="Password" value="@Model.Password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div>
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            </div>
        }

        <button type="submit" class="mt-1 btn btn-primary">Confirm</button>
    </form>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
