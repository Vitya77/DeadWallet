@model EmailRecoverPasswordViewModel
@{
    ViewData["Title"] = "Recover password";
}

<section class="w-100 h-100 d-flex justify-content-center align-items-center">
    <form style="width: 400px;" class="d-flex flex-column gap-3 border-1 border-black" asp-action="RecoverPasswordEmail" method="post">
        <div class="form-group">
            <label for="email">Email</label>
            <input type="text" class="form-control" id="email" name="email" value="@Model.Email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div>
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            </div>
        }

        <button type="submit" class="mt-1 btn btn-primary">Confirm</button>
    </form>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
