@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<section  class="w-100 h-100 d-flex justify-content-center align-items-center">
    <form style="width: 400px;" class="d-flex flex-column gap-3 border-1 border-black" asp-action="Login" method="post">
        <div class="form-group">
            <label for="Email">Email</label>
            <input type="text" class="form-control" id="Email" name="Email" value="@Model.Email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label  for="Password">Password</label>
            <input type="password" class="form-control" id="Password" name="Password" value="@Model.Password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div>
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            </div>
        }

        <button type="submit" class="mt-1 btn btn-primary">Login</button>
    </form>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
